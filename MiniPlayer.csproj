<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GlassPlayer</AssemblyName>
    <ApplicationIcon>Assets/GlassPlayer.ico</ApplicationIcon>
    <Version>2.5.0</Version>
    <Product>Glass Player</Product>
    <Description>Floating music player with synced lyrics</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Shaders/Glass.ps" />
    <Resource Include="Assets/GlassPlayer.ico" />
    <Resource Include="Assets/logo.png" />
    <EmbeddedResource Include="Localization/en.json" LogicalName="GlassPlayer.Localization.en.json" />
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Remove="tests/**/*" />
    <None Remove="tests/**/*" />
  </ItemGroup>
</Project>
