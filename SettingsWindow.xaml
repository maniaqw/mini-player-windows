<Window x:Class="GlassPlayer.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GlassPlayer"
 Title="{DynamicResource UiSettingsTitle}" Width="540" Height="910" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" FontFamily="Segoe UI" Foreground="{DynamicResource SettingsText}" KeyDown="WindowKeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#31CFC4"/>
  <Style x:Key="DiscordToggle" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="36" Height="21" CornerRadius="10.5" Background="{DynamicResource SettingsTrack}"><Ellipse x:Name="Knob" Width="15" Height="15" Fill="{DynamicResource SettingsSecondary}" HorizontalAlignment="Left" Margin="3"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource SettingsBackground}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SettingsText}"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{DynamicResource SettingsMuted}" Margin="1,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SmallButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource SettingsSecondary}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{DynamicResource SettingsSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource SettingsText}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton" x:Key="ThemeCard">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="5"/><Setter Property="GroupName" Value="Themes"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Card" CornerRadius="14" Background="{DynamicResource SettingsCard}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" Padding="7">
     <Grid><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="23"/></Grid.RowDefinitions>
      <Border Background="{Binding Background}" CornerRadius="7"><local:ThemePreview Theme="{Binding}" Margin="5"/></Border>
      <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource SettingsSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
      <TextBlock x:Name="Tick" Grid.Row="1" Text="✓" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource SettingsHover}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SettingsHoverBorder}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource SettingsSelected}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Shell" Margin="8" CornerRadius="24" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" Background="{DynamicResource SettingsBackground}">
  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#0A1115" Opacity="0.7"/></Border.Effect>
  <Grid Margin="19,0,19,0">
   <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="HeaderDrag"><Image Source="Assets/logo.png" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <StackPanel VerticalAlignment="Center" Margin="44,0,0,0"><TextBlock Text="GLASS PLAYER" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/><TextBlock Text="{DynamicResource UiAppearance}" FontWeight="SemiBold" FontSize="24"/></StackPanel>
    <Button Style="{StaticResource SmallButton}" Content="✕" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{DynamicResource UiCloseSettings}" AutomationProperties.Name="{DynamicResource UiCloseSettings}" Click="CloseClick"/>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <StackPanel>
     <Grid Margin="6,0,6,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource UiLanguage}" Foreground="{DynamicResource SettingsSecondary}" VerticalAlignment="Center" FontSize="12"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RussianButton" Style="{StaticResource SmallButton}" Content="Русский" Tag="ru" Click="LanguageClick" Margin="0,0,6,0"/><Button x:Name="EnglishButton" Style="{StaticResource SmallButton}" Content="English" Tag="en" Click="LanguageClick"/></StackPanel>
     </Grid>
     <Border CornerRadius="14" Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" Margin="5,0,5,21" Padding="15,12">
      <StackPanel>
       <Grid><TextBlock Text="{DynamicResource UiScale}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/><Border HorizontalAlignment="Right" CornerRadius="8" Background="{DynamicResource SettingsSelected}" Padding="9,4"><TextBlock x:Name="ScaleLabel" Text="100%" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/></Border></Grid>
       <Slider x:Name="ScaleSlider" Minimum="60" Maximum="150" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Margin="0,14,0,10" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="{DynamicResource UiScale}" ValueChanged="ScaleChanged">
        <Slider.Template><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Height="24">
         <Border Height="4" CornerRadius="2" Background="{DynamicResource SettingsTrack}" VerticalAlignment="Center"/>
         <Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource AccentBrush}" Height="4" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource SettingsThumb}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Slider.Template>
       </Slider>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button Style="{StaticResource SmallButton}" Content="75%" Tag="75" Margin="0,0,7,0" Click="ScalePreset"/>
        <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="100%" Tag="100" Margin="0,0,7,0" Click="ScalePreset"/>
        <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="125%" Tag="125" Margin="0,0,7,0" Click="ScalePreset"/>
        <Button Grid.Column="3" Style="{StaticResource SmallButton}" Content="150%" Tag="150" Click="ScalePreset"/>
       </Grid>
      </StackPanel>
     </Border>
     <Border CornerRadius="14" Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" Margin="5,0,5,21" Padding="15,13">
      <StackPanel>
       <Grid><TextBlock Text="Discord Rich Presence" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="DiscordEnabledToggle" Style="{StaticResource DiscordToggle}" HorizontalAlignment="Right" Checked="DiscordToggleChanged" Unchecked="DiscordToggleChanged" AutomationProperties.Name="Discord Rich Presence"/></Grid>
       <TextBlock Text="{DynamicResource UiDiscordDescription}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SettingsSecondary}" Margin="0,7,0,12"/>
       <TextBlock Text="Application ID" FontSize="10" Foreground="{DynamicResource SettingsMuted}" Margin="0,0,0,5"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="DiscordIdInput" AutomationProperties.Name="Discord Application ID" MaxLength="20" FontSize="12" Padding="9,7" Foreground="{DynamicResource SettingsText}" Background="{DynamicResource SettingsBackground}" BorderBrush="{DynamicResource SettingsBorder}" CaretBrush="{DynamicResource AccentBrush}" VerticalContentAlignment="Center" KeyDown="DiscordIdKeyDown" TextChanged="DiscordIdEdited"><TextBox.Template><ControlTemplate TargetType="TextBox"><Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></TextBox.Template></TextBox>
        <Button Grid.Column="1" Content="{DynamicResource UiApply}" Style="{StaticResource SmallButton}" Margin="7,0,0,0" Click="DiscordApplyClick"/>
       </Grid>
       <TextBlock x:Name="DiscordStatusLabel" TextWrapping="Wrap" Foreground="{DynamicResource SettingsMuted}" FontSize="11" Margin="0,9,0,0"/>
       <TextBlock x:Name="DiscordPreview" TextWrapping="Wrap" Foreground="{DynamicResource SettingsSecondary}" FontSize="11" Margin="0,5,0,0"/>
       <Button Content="Discord Developer Portal ↗" Style="{StaticResource SmallButton}" Padding="0,6,0,0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" FontSize="10" Click="OpenDiscordPortal" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock Text="{DynamicResource UiStyles}" Foreground="{DynamicResource SettingsMuted}" FontSize="10" Margin="6,0,0,8"/>
     <ItemsControl x:Name="ThemeList">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><RadioButton Style="{StaticResource ThemeCard}" Tag="{Binding}" AutomationProperties.Name="{Binding Name}" Checked="ThemeSelected"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" Margin="6,0"><TextBlock x:Name="SaveStatus" Text="{DynamicResource UiSaved}" Foreground="{DynamicResource SettingsMuted}" FontSize="11" VerticalAlignment="Center"/><Button Style="{StaticResource SmallButton}" Content="{DynamicResource UiReset}" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ResetClick"/></Grid>
  </Grid>
 </Border>
</Window>
