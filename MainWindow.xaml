<Window x:Class="GlassPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GlassPlayer"
 Icon="Assets/GlassPlayer.ico" Title="Glass Player" Width="650" Height="144" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" MouseLeftButtonDown="DragWindow" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="SeekStyle" TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="22" Background="Transparent"><Border Height="5" CornerRadius="2.5" VerticalAlignment="Center" Background="{DynamicResource PlayerTrack}"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" CornerRadius="2.5" VerticalAlignment="Center" Background="{DynamicResource PlayerAccent}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="13" Height="13"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource PlayerText}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#C8DCD9"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="26"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource PlayerHover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Viewbox Stretch="Fill"><Grid x:Name="PlayerCanvas" Width="650" Height="144" Background="Transparent" ClipToBounds="True">
  <Rectangle x:Name="Glass" Fill="White" IsHitTestVisible="False"><Rectangle.Effect><local:GlassEffect x:Name="GlassShader"/></Rectangle.Effect></Rectangle>
  <Grid x:Name="Body" Margin="12" Height="120" VerticalAlignment="Top" Background="Transparent">
   <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="61"/><ColumnDefinition Width="77"/></Grid.ColumnDefinitions>
   <Border x:Name="DiscBackdrop" Width="106" Height="108" Margin="6,0,0,0" HorizontalAlignment="Left" CornerRadius="28" Background="#86122428">
    <Grid Width="76" Height="76">
     <Ellipse Fill="#243F41"/>
     <TextBlock Text="♫" FontSize="36" Foreground="#9CBFB6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
     <Grid x:Name="Disc" RenderTransformOrigin="0.5,0.5">
      <Grid.Clip><EllipseGeometry Center="38,38" RadiusX="38" RadiusY="38"/></Grid.Clip>
      <Grid.RenderTransform><RotateTransform x:Name="DiscRotation"/></Grid.RenderTransform>
      <Grid x:Name="OldCoverLayer" RenderTransformOrigin="0.5,0.5" Opacity="0"><Grid.RenderTransform><ScaleTransform x:Name="OldCoverScale"/></Grid.RenderTransform><Image x:Name="PreviousCover" Stretch="UniformToFill"/></Grid>
      <Grid x:Name="NewCoverLayer" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="NewCoverScale"/></Grid.RenderTransform><Image x:Name="Cover" Stretch="UniformToFill"/></Grid>
     </Grid>
     <Grid x:Name="VinylDetails" IsHitTestVisible="False" Visibility="Collapsed"><Ellipse Width="54.7" Height="54.7" Stroke="#18FFFFFF" StrokeThickness="1.8"/><Ellipse Width="20.5" Height="20.5" Stroke="#4DFFFFFF" StrokeThickness="1.8"/><Ellipse Width="16.1" Height="16.1" Fill="#EB0E0E12"/></Grid>
    </Grid>
   </Border>
   <Grid Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
    <Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="33"/></Grid.RowDefinitions>
    <local:AnimatedLine x:Name="TrackTitle" Text="{DynamicResource UiPlayMusic}" Foreground="#F1F6F3" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold"/>
    <local:AnimatedLine x:Name="Artist" Grid.Row="1" Text="{DynamicResource UiWaiting}" Foreground="#D4E1DB" FontFamily="Segoe UI" FontSize="23" FontWeight="SemiBold"/>
   </Grid>
   <Button Grid.Column="2" Width="48" Height="44" VerticalAlignment="Center" Margin="0,31,0,0" ToolTip="{DynamicResource UiSources}" AutomationProperties.Name="{DynamicResource UiSources}" Click="MenuClick">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse x:Name="Dot1" Width="4" Height="4" Fill="#A8B8AB" Margin="0,0,8,0"/><Ellipse x:Name="Dot2" Width="4" Height="4" Fill="#A8B8AB" Margin="0,0,8,0"/><Ellipse x:Name="Dot3" Width="4" Height="4" Fill="#A8B8AB"/></StackPanel>
   </Button>
   <Button x:Name="Play" Grid.Column="3" Width="57" Height="57" HorizontalAlignment="Left" ToolTip="{DynamicResource UiPlayPause}" AutomationProperties.Name="{DynamicResource UiPlayPause}" Click="PlayClick">
    <Grid Width="57" Height="57">
     <Ellipse x:Name="RingTrack" Margin="3" Stroke="#24474B" StrokeThickness="4"/>
     <Path x:Name="ProgressRing" Stroke="#D37F6B" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
     <Grid x:Name="PauseIcon" Width="17" Height="23"><Border x:Name="PauseBar1" Width="5" CornerRadius="1" Background="#B5CFCA" HorizontalAlignment="Left"/><Border x:Name="PauseBar2" Width="5" CornerRadius="1" Background="#B5CFCA" HorizontalAlignment="Right"/></Grid>
     <Path x:Name="PlayIcon" Data="M 23,18 L 39,28.5 23,39 Z" Fill="#B5CFCA" Visibility="Collapsed"/>
    </Grid>
   </Button>
  </Grid>
  <Grid x:Name="ExpandedControls" Height="92" Margin="36,140,36,0" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
   <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="48"/></Grid.RowDefinitions>
   <Slider x:Name="SeekSlider" Style="{StaticResource SeekStyle}" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="SeekStart" PreviewMouseMove="SeekMove" PreviewMouseLeftButtonUp="SeekEnd" LostMouseCapture="SeekLostCapture" AutomationProperties.Name="{DynamicResource UiSeek}"/>
   <TextBlock x:Name="ElapsedTime" Grid.Row="1" Text="0:00" FontSize="13" Foreground="{DynamicResource PlayerSecondary}" VerticalAlignment="Center"/>
   <TextBlock x:Name="RemainingTime" Grid.Row="1" Text="−0:00" FontSize="13" Foreground="{DynamicResource PlayerSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
   <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
    <Button x:Name="ShuffleButton" Content="⇄" Width="37" FontSize="22" Click="ShuffleClick" Foreground="{DynamicResource PlayerSecondary}" AutomationProperties.Name="{DynamicResource UiShuffle}" ToolTip="{DynamicResource UiShuffle}"/>
    <Button x:Name="PreviousButton" Content="⏮" Width="37" FontSize="17" Click="PreviousClick" Foreground="{DynamicResource PlayerText}" AutomationProperties.Name="{DynamicResource UiPrevious}" ToolTip="{DynamicResource UiPrevious}"/>
    <Button x:Name="ExpandedPlayButton" Content="▶" Width="43" FontSize="21" Click="PlayClick" Foreground="{DynamicResource PlayerText}" AutomationProperties.Name="{DynamicResource UiPlayPause}" ToolTip="{DynamicResource UiPlayPause}"/>
    <Button x:Name="NextButton" Content="⏭" Width="37" FontSize="17" Click="NextClick" Foreground="{DynamicResource PlayerText}" AutomationProperties.Name="{DynamicResource UiNext}" ToolTip="{DynamicResource UiNext}"/>
    <Button x:Name="RepeatButton" Content="↻" Width="37" FontSize="24" Click="RepeatClick" Foreground="{DynamicResource PlayerSecondary}" AutomationProperties.Name="{DynamicResource UiRepeat}" ToolTip="{DynamicResource UiRepeat}"/>
   </StackPanel>
  </Grid>
 </Grid></Viewbox>
</Window>
